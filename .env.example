# --- Telegram (https://my.telegram.org and @BotFather) ---
API_ID=1234567
API_HASH=your_telegram_api_hash
BOT_TOKEN=123456:your_bot_token

# --- FilePress ---
FILEPRESS_API_KEY=your_filepress_api_key
# These domains can change; update them here if FilePress moves.
FILEPRESS_API_URL=https://api.filebee.top/api/v1/file/add
FILEPRESS_BASE_URL=https://filepress.live

# --- Upload route ---
# auto     = direct FilePress upload if FILEPRESS_UPLOAD_URL is set, else Google Drive
# filepress = direct FilePress upload only
# drive    = Google Drive -> FilePress only
UPLOAD_BACKEND=auto
# Direct upload endpoint (multipart/form-data). Take the exact values from your
# FilePress API docs; leave empty to use Google Drive only.
FILEPRESS_UPLOAD_URL=https://filebee.xyz/api/v1/file/add
FILEPRESS_UPLOAD_FILE_FIELD=file
# How the API key is sent: body (form field), bearer (Authorization header) or header
FILEPRESS_UPLOAD_AUTH=body
# Form-field name (body) or header name (header) that carries the key
FILEPRESS_UPLOAD_KEY_FIELD=key

# --- Google Drive (optional when direct upload is configured) ---
# Path to the service-account JSON key file.
GDRIVE_SERVICE_ACCOUNT_FILE=service-account.json
# Optional: folder (or Shared Drive folder) ID that uploads go into. Leave empty for the root.
GDRIVE_FOLDER_ID=

# --- Runtime ---
DOWNLOAD_DIR=downloads
DATABASE_PATH=data/uploads.sqlite3
PORT=8080
LOG_LEVEL=INFO

# Optional: protects the dashboard (/ and /api/status). Open it as /?token=VALUE
DASHBOARD_TOKEN=
# Optional keep-alive: public URL of this service's /health, pinged every N seconds
# (only needed on hosts that put idle web services to sleep).
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_SECONDS=300

# Telegram bot-side file size limit in bytes (default ~2000 MiB).
# Do not increase to claim 4 GB support.
TELEGRAM_MAX_FILE_SIZE_BYTES=2097152000
