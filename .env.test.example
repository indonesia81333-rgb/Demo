# Copy to .env.test and use a SEPARATE test bot (create one with @BotFather)
# and a test Drive folder, so test uploads never touch production.
API_ID=1234567
API_HASH=your_telegram_api_hash
BOT_TOKEN=123456:your_TEST_bot_token
FILEPRESS_API_KEY=your_filepress_api_key
FILEPRESS_API_URL=https://api.filebee.top/api/v1/file/add
FILEPRESS_BASE_URL=https://filepress.live
UPLOAD_BACKEND=auto
FILEPRESS_UPLOAD_URL=
GDRIVE_FOLDER_ID=your_test_folder_id
LOG_LEVEL=DEBUG
# Small limit so the "file too large" path is easy to test (10 MiB).
TELEGRAM_MAX_FILE_SIZE_BYTES=10485760
